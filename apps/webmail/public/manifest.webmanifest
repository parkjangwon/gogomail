{
  "name": "GoGoMail Webmail",
  "short_name": "GoGoMail",
  "description": "GoGoMail webmail — mail, calendar, contacts, and drive.",
  "id": "/mail",
  "start_url": "/mail",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#2f6ee0",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "business"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Compose",
      "short_name": "Compose",
      "url": "/compose",
      "description": "Write a new message"
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/mail",
      "description": "Open the inbox"
    }
  ]
}
